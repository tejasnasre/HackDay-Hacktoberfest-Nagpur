# Optional: a Gemini key built into the app, used when someone picks Gemini
# without adding their own key. It ships inside the app bundle, so use a
# restricted key. Copy to .env.local (git-ignored) to use it.
EXPO_PUBLIC_GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.5-flash-lite).
EXPO_PUBLIC_GEMINI_MODEL=
